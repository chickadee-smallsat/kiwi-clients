{
  "name": "kiwi-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Unit and end-to-end tests for the Kiwi clients",
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
